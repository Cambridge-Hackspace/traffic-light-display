# cpu config
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_SYSTEM_EVENT_TASK_PINNED_TO_CORE_0=y  # make sure wifi is pinned to core 0,
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y          # keeping it separate from display thread

# timing config
CONFIG_FREERTOS_HZ=1000

# stack config
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# iram config
CONFIG_ESP_WIFI_IRAM_OPT=y      # prevent wifi from locking
CONFIG_ESP_WIFI_RX_IRAM_OPT=y   # up the flash memory, which
CONFIG_RMT_ISR_IRAM_SAFE=y      # may bork the display

# http config
# NB: unlike the "=y" lines above, integer and string values must NOT carry a
# trailing comment -- kconfiglib fails to parse the value and silently falls
# back to the esp-idf default.
# Basic auth on top of a browser's usual header block:
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
# Discarding the tail of a rejected multi-megabyte upload 32 bytes at a time
# would take tens of thousands of recv calls:
CONFIG_HTTPD_PURGE_BUF_LEN=1024

# ota config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y   # the module is 4MB; the esp-idf default is 2MB
CONFIG_PARTITION_TABLE_CUSTOM=y    # two app slots, see partitions.csv
# The path is resolved against the CMake project dir, which for esp-idf-sys is
# the generated project under target/<triple>/<profile>/build/esp-idf-sys-<hash>/out
# -- six levels below this file, not next to it. A path that does not resolve is
# only a CMake *warning*, so verify by decoding the generated partition-table.bin.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y  # revert an image that never marks itself valid
